{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "papela-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "papela-site-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "papela-site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:preview"],
      "port": 3002,
      "autoPort": true
    }
  ]
}
