# Variables de entorno de papela-site (copiar a .env.local; los valores reales viven en Vercel).
# Solo se listan las de analítica; ver CLAUDE.md para el resto.

# GA4 Measurement Protocol: el webhook de MercadoPago manda `purchase` desde el servidor.
# Sin estas dos variables el envío se omite en silencio (la compra en cliente sigue funcionando).
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# Rate limit compartido entre instancias (auditoría 2026-10-16, Fase 1).
# Base Redis de Upstash (plan gratis: 10k comandos/día); las mismas dos
# variables van en papela-admin. Sin ellas el límite es por instancia (memoria)
# y se avisa una vez en el log — el sitio sigue funcionando.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Purga de pedidos de tienda pendientes > 48 h (GET /api/cron/purgar-pedidos,
# cron de Vercel). Vercel manda `Authorization: Bearer $CRON_SECRET` solo.
CRON_SECRET=

# Revalidación bajo demanda de los Mini Sites (ISR de /<slug>): el admin llama
# a POST /api/revalidate/mini-site con este secreto al publicar o editar.
# Misma variable en papela-admin.
MINI_SITES_REVALIDATE_SECRET=
